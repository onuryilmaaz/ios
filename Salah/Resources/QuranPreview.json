  "verses": [
    {
      "id": 1,
      "surah_id": 1,
      "verse_number": 1,
      "verse_simplified": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
      "page_number": 1,
      "juz_number": 1,
      "transcription": "Bismillahirrahmanirrahim",
      "translation": {
        "id": 1,
        "text": "Rahman ve Rahim olan Allah'ın adıyla",
        "author": {
          "id": "diyanet",
          "name": "Diyanet İşleri"
        }
      }
    },
    {
      "id": 2,
      "surah_id": 1,
      "verse_number": 2,
      "verse_simplified": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",
      "page_number": 1,
      "juz_number": 1,
      "transcription": "El hamdü lillahi rabbil alemin",
      "translation": {
        "id": 2,
        "text": "Hamd, Alemlerin Rabbi Allah'a mahsustur",
        "author": {
          "id": "diyanet",
          "name": "Diyanet İşleri"
        }
      }
    },
    {
      "id": 3,
      "surah_id": 1,
      "verse_number": 3,
      "verse_simplified": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ",
      "page_number": 1,
      "juz_number": 1,
      "transcription": "Er rahmanir rahıym",
      "translation": {
        "id": 3,
        "text": "O Rahman ve Rahim'dir",
        "author": {
          "id": "diyanet",
          "name": "Diyanet İşleri"
        }
      }
    },
    {
      "id": 4,
      "surah_id": 1,
      "verse_number": 4,
      "verse_simplified": "مَٰلِكِ يَوۡمِ ٱلدِّينِ",
      "page_number": 1,
      "juz_number": 1,
      "transcription": "Maliki yevmid din",
      "translation": {
        "id": 4,
        "text": "Din Gününün sahibidir",
        "author": {
          "id": "diyanet",
          "name": "Diyanet İşleri"
        }
      }
    },
    {
      "id": 5,
      "surah_id": 1,
      "verse_number": 5,
      "verse_simplified": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ",
      "page_number": 1,
      "juz_number": 1,
      "transcription": "İyyake na´büdü ve iyyake nesteıyn",
      "translation": {
        "id": 5,
        "text": "Ancak Sana kulluk eder ve yalnız Senden yardım dileriz",
        "author": {
          "id": "diyanet",
          "name": "Diyanet İşleri"
        }
      }
    },
    {
      "id": 6,
      "surah_id": 1,
      "verse_number": 6,
      "verse_simplified": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",
      "page_number": 1,
      "juz_number": 1,
      "transcription": "İhdinas sıratal müstekıym",
      "translation": {
        "id": 6,
        "text": "Bizi doğru yola eriştir",
        "author": {
          "id": "diyanet",
          "name": "Diyanet İşleri"
        }
      }
    },
    {
      "id": 7,
      "surah_id": 1,
      "verse_number": 7,
      "verse_simplified": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ",
      "page_number": 1,
      "juz_number": 1,
      "transcription": "Sıratallezine en´amte aleyhim ğayril mağdubi aleyhim ve lad dallin",
      "translation": {
        "id": 7,
        "text": "Nimete erdirdiğin kimselerin yoluna; gazaba uğrayanların, ya da sapıtanların yoluna değil",
        "author": {
          "id": "diyanet",
          "name": "Diyanet İşleri"
        }
      }
    }
  ],
  "english": {
    "1": "In the name of Allah, the Entirely Merciful, the Especially Merciful",
    "2": "[All] praise is [due] to Allah, Lord of the worlds",
    "3": "The Entirely Merciful, the Especially Merciful",
    "4": "Sovereign of the Day of Recompense",
    "5": "It is You we worship and You we ask for help",
    "6": "Guide us to the straight path",
    "7": "The path of those upon whom You have bestowed favor, not of those who have evoked [Your] anger or of those who are astray"
  },
  "englishAuthor": "Umm Muhammad"
}
